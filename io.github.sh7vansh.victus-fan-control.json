{
  "app-id": "io.github.sh7vansh.victus-fan-control",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "fan-control",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--talk-name=org.freedesktop.Flatpak",
    "--system-talk-name=net.hadess.PowerProfiles",
    "--filesystem=/run/victus-fan-control.sock"
  ],
  "modules": [
    {
      "name": "victus-fan-control",
      "buildsystem": "simple",
      "build-commands": [
        "python3 packaging/install_files.py --prefix=/app"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/sh7vansh/victus-fan-control.git",
          "commit": "7b5c9ff00b3a4b4349459e0e17ba256527eebc86"
        }
      ]
    }
  ],
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.golang"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/golang/bin",
    "env": {
      "CGO_ENABLED": "0",
      "GOTOOLCHAIN": "local",
      "GOPROXY": "off",
      "GOROOT": "/usr/lib/sdk/golang"
    }
  }
}
